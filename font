describe "install" <<HEREDOC
Usage:
  ${_ME} install <source> <font>
  ${_ME} install <url>
  ${_ME} install [--source <source>] [--font <font>] [--url <url>]

Options:
  --font <font>      The font to install, by name.
  --source <source>  The source to install the font from.
  --url <url>        The URL of the font to install.

Description:
  Install a <font> from <source>, or from a font <url>. The options are
  equivalent to the arguments and can be mixed with them, so
  \`${_ME} install --source google "Open Sans"\` also works. --url can't be
  combined with a source or font.

Sources:
  fontshare   A font from Fontshare, by name.
  google      A font family from Google Fonts, by name.
  homebrew    A font cask from Homebrew, by cask name. macOS only.
  url         A link to a .zip, .ttf, or .otf file, or a file:// URL for a
              local file.

URLs:
  Fontshare and Google Fonts pages, Homebrew cask pages, and direct links
  to .zip, .ttf, or .otf files, including file:// URLs for local files,
  are recognized, so a <url> can be used anywhere a <source> and <font>
  are accepted.

Examples:
  ${_ME} install fontshare paquito
  ${_ME} install google "Open Sans"
  ${_ME} install homebrew font-fira-code
  ${_ME} install https://www.fontshare.com/fonts/paquito
  ${_ME} install https://fonts.google.com/specimen/Montserrat
  ${_ME} install https://example.com/fonts/Example.zip
  ${_ME} install file:///Users/example/Downloads/Example.zip
  ${_ME} install --source google --font "Open Sans"
  ${_ME} install --url https://fonts.google.com/specimen/Montserrat
HEREDOC
install() {
  # _install_from_fontshare()
  #
  # Usage:
  #   _install_from_fontshare <font> <manifest_file>
  #
  # Description:
  #   Download a font archive from Fontshare's API, copy font files into
  #   `$_FONT_DIR`, and record installed paths in `<manifest_file>`.
  _install_from_fontshare() {
    _debug printf "_install_from_fontshare()\\n"

    local _font="${1}"
    local _manifest_file="${2}"
    local _url="https://api.fontshare.com/v2/fonts/download/${_font}"
    local _tmp_zip=
    local _tmp_dir=

    _tmp_zip="$(_temp file ".zip")"
    _tmp_dir="$(_temp file "extracted-${_font}")"

    mkdir -p "${_FONT_DIR}" "$(dirname "${_manifest_file}")" "${_tmp_dir}"

    _debug printf "Downloading %s from %s\\n" "${_font}" "${_url}"
    printf "Downloading '%s' from fontshare...\n" "${_font}"

    if ! curl -fsSL "${_url}" -o "${_tmp_zip}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to download '%s' from fontshare.\\n" "${_font}"
    fi

    if ! unzip -q "${_tmp_zip}" -d "${_tmp_dir}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to extract archive for '%s'.\\n" "${_font}"
    fi

    : > "${_manifest_file}"

      local _base_name=
    local _dest_path=
    local _font_file=

    while IFS= read -r -d '' _font_file
    do
      _base_name="$(basename "${_font_file}")"
      _dest_path="${_FONT_DIR}/${_base_name}"

      cp -f "${_font_file}" "${_dest_path}"

      printf "%s\n" "${_dest_path}" >> "${_manifest_file}"

      _count=$((_count + 1))
    done < <(find "${_tmp_dir}" -type f \( -name "*.otf" -o -name "*.ttf" \) -print0)

    if (( _count == 0 ))
    then
      rm -f "${_manifest_file}"

      _exit_1 printf "No .otf or .ttf files found in archive for '%s'.\\n" "${_font}"
    fi

    printf "Installed %d font file(s) for '%s' into %s\n"   \
      "${_count}"                                           \
      "${_font}"                                            \
      "${_FONT_DIR}"
  }

  # _install_from_google()
  #
  # Usage:
  #   _install_from_google <font> <manifest_file>
  #
  # Description:
  #   Download a font family archive from Google Fonts, copy font files into
  #   `$_FONT_DIR`, and record installed paths in `<manifest_file>`.
  _install_from_google() {
    _debug printf "_install_from_google()\\n"

    local _font="${1}"
    local _manifest_file="${2}"
    local _url="https://fonts.google.com/download?family=${_font// /%20}"
    local _tmp_zip=
    local _tmp_dir=

    _tmp_zip="$(_temp file ".zip")"
    _tmp_dir="$(_temp file "extracted-${_font}")"

    mkdir -p "${_FONT_DIR}" "$(dirname "${_manifest_file}")" "${_tmp_dir}"

    _debug printf "Downloading %s from %s\\n" "${_font}" "${_url}"
    printf "Downloading '%s' from google...\n" "${_font}"

    if ! curl -fsSL "${_url}" -o "${_tmp_zip}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to download '%s' from google.\\n" "${_font}"
    fi

    if ! unzip -q "${_tmp_zip}" -d "${_tmp_dir}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to extract archive for '%s'.\\n" "${_font}"
    fi

    : > "${_manifest_file}"

      local _base_name=
    local _dest_path=
    local _font_file=

    while IFS= read -r -d '' _font_file
    do
      _base_name="$(basename "${_font_file}")"
      _dest_path="${_FONT_DIR}/${_base_name}"

      cp -f "${_font_file}" "${_dest_path}"

      printf "%s\n" "${_dest_path}" >> "${_manifest_file}"

      _count=$((_count + 1))
    done < <(find "${_tmp_dir}" -type f \( -name "*.otf" -o -name "*.ttf" \) -print0)

    if (( _count == 0 ))
    then
      rm -f "${_manifest_file}"

      _exit_1 printf "No .otf or .ttf files found in archive for '%s'.\\n" "${_font}"
    fi

    printf "Installed %d font file(s) for '%s' into %s\n"   \
      "${_count}"                                           \
      "${_font}"                                            \
      "${_FONT_DIR}"
  }

  # _install_from_homebrew()
  #
  # Usage:
  #   _install_from_homebrew <font> <manifest_file>
  #
  # Description:
  #   Install a font cask with Homebrew and record the cask name in
  #   `<manifest_file>`. Homebrew manages the font files, so the manifest only
  #   marks the cask as installed with this program.
  _install_from_homebrew() {
    _debug printf "_install_from_homebrew()\\n"

    local _font="${1}"
    local _manifest_file="${2}"

    if [[ "${_OS}" != "Darwin" ]]
    then
      _exit_1 printf "Homebrew font casks are only available on macOS.\\n"
    fi

    if [[ "${_font}" != font-* ]]
    then
      _exit_1 printf "Not a font cask: '%s'. Font casks start with 'font-'.\\n" "${_font}"
    fi

    mkdir -p "$(dirname "${_manifest_file}")"

    printf "Installing '%s' with homebrew...\n" "${_font}"

    if ! brew install --cask "${_font}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to install '%s' with homebrew.\\n" "${_font}"
    fi

    printf "%s\n" "${_font}" > "${_manifest_file}"

    printf "Installed '%s' with homebrew\n" "${_font}"
  }

  # _install_from_url()
  #
  # Usage:
  #   _install_from_url <font> <manifest_file> <url>
  #
  # Description:
  #   Download a .zip archive or a single .ttf or .otf file from <url>, or copy
  #   it from the local path of a `file://` <url>, copy font files into
  #   `$_FONT_DIR`, and record installed paths in `<manifest_file>`.
  _install_from_url() {
    _debug printf "_install_from_url()\\n"

    local _font="${1}"
    local _manifest_file="${2}"
    local _url="${3:-}"

    if [[ -z "${_url}" ]]
    then
      _exit_1 printf "A URL is required. Usage: %s install <url>\\n" "${_ME}"
    fi

    local _url_path="${_url%%[?#]*}"
    local _file_name=
    local _extension=
    local _local_path=
    local _tmp_download=
    local _tmp_dir=

    _file_name="$(_url_decode "${_url_path##*/}")"
    _extension="$(printf "%s" "${_file_name##*.}" | tr '[:upper:]' '[:lower:]')"

    case "${_extension}" in
      zip|ttf|otf)
        :
        ;;
      *)
        _exit_1 printf "Unsupported URL: %s\\nExpected a fontshare, google, or homebrew page, or a link to a .zip, .ttf, or .otf file.\\n" "${_url}"
        ;;
    esac

    if [[ "${_url}" == file://* ]]
    then
      _local_path="${_url#file://}"
      _local_path="${_local_path#localhost}"
      _local_path="$(_url_decode "${_local_path%%[?#]*}")"

      if [[ "${_local_path}" != /* ]]
      then
        _exit_1 printf "Unsupported file URL: %s\\nUse an absolute path, like file:///path/to/Example.zip\\n" "${_url}"
      fi

      if [[ ! -f "${_local_path}" ]]
      then
        _exit_1 printf "File not found: %s\\n" "${_local_path}"
      fi
    fi

    _tmp_download="$(_temp file ".${_extension}")"
    _tmp_dir="$(_temp file "extracted-${_font}")"

    mkdir -p "${_FONT_DIR}" "$(dirname "${_manifest_file}")" "${_tmp_dir}"

    if [[ -n "${_local_path}" ]]
    then
      _debug printf "Copying %s from %s\\n" "${_font}" "${_local_path}"
      printf "Copying '%s' from %s...\n" "${_font}" "${_local_path}"

      cp -f "${_local_path}" "${_tmp_download}"
    else
      _debug printf "Downloading %s from %s\\n" "${_font}" "${_url}"
      printf "Downloading '%s' from %s...\n" "${_font}" "${_url}"

      if ! curl -fsSL "${_url}" -o "${_tmp_download}"
      then
        rm -f "${_manifest_file}"
        _exit_1 printf "Failed to download '%s'.\\n" "${_url}"
      fi
    fi

    if [[ "${_extension}" == "zip" ]]
    then
      if ! unzip -q "${_tmp_download}" -d "${_tmp_dir}"
      then
        rm -f "${_manifest_file}"
        _exit_1 printf "Failed to extract archive for '%s'.\\n" "${_font}"
      fi
    else
      cp -f "${_tmp_download}" "${_tmp_dir}/${_file_name}"
    fi

    : > "${_manifest_file}"

      local _base_name=
    local _dest_path=
    local _font_file=

    while IFS= read -r -d '' _font_file
    do
      _base_name="$(basename "${_font_file}")"
      _dest_path="${_FONT_DIR}/${_base_name}"

      cp -f "${_font_file}" "${_dest_path}"

      printf "%s\n" "${_dest_path}" >> "${_manifest_file}"

      _count=$((_count + 1))
    done < <(find "${_tmp_dir}" -type f \( -name "*.otf" -o -name "*.ttf" \) -print0)

    if (( _count == 0 ))
    then
      rm -f "${_manifest_file}"

      _exit_1 printf "No .otf or .ttf files found for '%s'.\\n" "${_font}"
    fi

    printf "Installed %d font file(s) for '%s' into %s\n"   \
      "${_count}"                                           \
      "${_font}"                                            \
      "${_FONT_DIR}"
  }

  _debug printf "_install()\\n"

  local _arguments=()
  local _font=
  local _font_url=
  local _resolved=
  local _source=
  local _url=


  while ((${#}))
  do
    case "${1:-}" in
      --font|--source|--url)
        if [[ -z "${2:-}" ]]
        then
          _exit_1 printf "%s requires a value.\\n" "${1}"
        fi

        case "${1}" in
          --font)   _font="${2}"    ;;
          --source) _source="${2}"  ;;
          --url)    _url="${2}"     ;;
        esac

        shift
        ;;
      *)
        if [[ -z "${_source:-}" ]]
        then
          _source="${1:-}"
        elif [[ -z "${_font:-}" ]]
        then
          _font="${1:-}"
        else
          _arguments+=("${1:-}")
        fi
        ;;
    esac

    shift
  done

  if [[ -n "${_url}" ]]
  then
    if ! _is_url "${_url}"
    then
      _exit_1 printf "Invalid URL: %s\\n" "${_url}"
    fi

    if [[ -n "${_source}" ]] || [[ -n "${_font}" ]]
    then
      _exit_1 printf "A URL can't be combined with a source or font.\\n"
    fi

    _source="${_url}"
  fi

  if [[ -z "${_font:-}" ]] && _is_url "${_source:-}"
  then
    _font_url="${_source}"
    _resolved="$(_resolve_font_url "${_font_url}")"

    _source="${_resolved%% *}"
    _font="${_resolved#* }"
  fi

  if [[ -z "${_source:-}" ]] ||
     [[ -z "${_font:-}"   ]]
  then
    _exit_1 printf "Usage: %s install ( <source> <font> | <url> | --source <source> --font <font> | --url <url> )\\n" "${_ME}"
  fi

  local _required_commands=(curl unzip)

  if [[ "${_source}" == "homebrew" ]]
  then
    _required_commands=(brew)
  elif [[ "${_font_url}" == file://* ]]
  then
    _required_commands=(unzip)
  fi

  local __command=
  for   __command in "${_required_commands[@]}"
  do
    _command_exists "${__command}" ||
      _exit_1 printf "Required command not found: %s\\n" "${__command}"
  done

  local _manifest_file=
  _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"

  case "${_source}" in
    fontshare)
      _install_from_fontshare "${_font}" "${_manifest_file}"
      ;;
    google)
      _install_from_google "${_font}" "${_manifest_file}"
      ;;
    homebrew)
      _install_from_homebrew "${_font}" "${_manifest_file}"
      ;;
    url)
      _install_from_url "${_font}" "${_manifest_file}" "${_font_url}"
      ;;
    *)
      _exit_1 printf "Unsupported font source: %s\\n" "${_source}"
      ;;
  esac

  _refresh_font_cache
}

# ----------------------------------------------------------------------- search

# _json_catalog()
# Extract Fontshare, Google Fonts, or Homebrew metadata.
# Fontshare/Google search and show use fast streaming field extraction;
# Homebrew's small single-cask response uses the general JSON reader below.
_json_catalog() {
  local _source="${1}" _wanted="${2}" _mode="${3}" _file="${4}"

  # Search needs only the top-level family name/slug. Splitting the minified
  # catalog at object starts lets awk extract those fields directly, avoiding
  # a character-by-character walk of the entire nested JSON document.
  if [[ "${_mode}" == "search" ]]
  then
    tr '{' '\012' < "${_file}" | awk -v source="${_source}" '
      function field(key, line,    pattern, value) {
        pattern = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
        if (!match(line, pattern)) return ""
        value = substr(line, RSTART, RLENGTH)
        sub(/^[^:]*:[[:space:]]*"/, "", value)
        sub(/"$/, "", value)
        gsub(/\\"/, "\"", value)
        gsub(/\\\\/, "\\", value)
        return value
      }
      {
        if (source == "google") {
          name = field("family", $0)
          id = name
          if (name == "") next
          gsub(/ /, "%20", name)
          printf "%s\t%s\thttps://fonts.google.com/specimen/%s\n", id, id, name
        } else {
          name = field("name", $0)
          id = field("slug", $0)
          if (name == "" || id == "") next
          printf "%s\t%s\thttps://www.fontshare.com/fonts/%s\n", name, id, id
        }
      }
    '
    return
  fi

  # For show, stream object fragments instead of constructing every nested
  # object and walking every character in the catalog. Top-level font records
  # are identified by their unique slug/family field; nested fragments are
  # inspected only while the requested record is active.
  if [[ "${_mode}" == "show" && ( "${_source}" == "fontshare" || "${_source}" == "google" ) ]]
  then
    tr '{' '\012' < "${_file}" | awk -v source="${_source}" -v wanted="${_wanted}" '
      function field(key, line,    pattern, value) {
        pattern = "\"" key "\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|[-+]?[0-9]+([.][0-9]+)?|true|false|null)"
        if (!match(line, pattern)) return ""
        value = substr(line, RSTART, RLENGTH)
        sub(/^[^:]*:[[:space:]]*/, "", value)
        if (substr(value,1,1)=="\"") {
          sub(/^\"/, "", value); sub(/\"$/, "", value)
          gsub(/\\\"/, "\"", value)
          gsub(/\\\\/, "\\", value)
          gsub(/\\n/, " ", value); gsub(/\\r/, " ", value); gsub(/\\t/, " ", value)
        }
        if (value=="null") return ""
        gsub(/[\t\r\n]/, " ", value)
        return value
      }
      function emit() {
        if (!active) return
        if (source == "fontshare")
          printf "%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%d\034%s\034%s\034%s\n", name, story, category, license, views, recent, publisher, designers, styles, variable, added, slug
        else
          printf "%s\034%s\034%s\034%s\034%s\034%d\034%d\034%s\n", name, category, designer, added, updated, styles, axes, description
        active=0
      }
      {
        if (source == "fontshare") {
          candidate=field("slug",$0)
          if (candidate != "") {
            emit()
            candidate_name=field("name",$0)
            active=(tolower(candidate)==tolower(wanted) || tolower(candidate_name)==tolower(wanted))
            if (active) {
              found=1
              name=candidate_name; slug=candidate; story=field("story",$0)
              category=field("category",$0); license=field("license_type",$0)
              views=field("views",$0); recent=field("views_recent",$0)
              variable=(field("is_variable",$0)=="true" ? "yes" : "no")
              added=field("inserted_at",$0); publisher=""; designers=""; styles=0
            }
          } else if (active) {
            nested_name=field("name",$0)
            if (nested_name!="") {
              if (publisher=="") publisher=nested_name
              else designers=(designers=="" ? nested_name : designers ", " nested_name)
            }
            if (field("id",$0)!="") styles++
            if (story=="") story=field("story",$0)
            if (category=="") category=field("category",$0)
            if (license=="") license=field("license_type",$0)
            if (views=="") views=field("views",$0)
            if (recent=="") recent=field("views_recent",$0)
            if (added=="") added=field("inserted_at",$0)
            if (field("is_variable",$0)=="true") variable="yes"
          }
        } else {
          candidate=field("family",$0)
          if (candidate!="") {
            emit()
            active=(tolower(candidate)==tolower(wanted))
            if (active) {
              found=1
              name=candidate; category=field("category",$0); designer=field("designer",$0)
              added=field("dateAdded",$0); updated=field("lastModified",$0)
              description=field("description",$0); styles=0; axes=0
            }
          } else if (active) {
            if (field("filename",$0)!="") styles++
            if (field("tag",$0)!="") axes++
          }
        }
      }
      END { emit(); if (!found) exit 1 }
    '
    return $?
  fi

  local _parser="$(_temp file .awk)" _input_file="${4}"
  if [[ "${_source}" == "google" ]]
  then
    _input_file="$(_temp file .json)"
    sed '1s/^[^{]*//' "${_file}" > "${_input_file}"
  fi
  cat > "${_parser}" <<'JSON_AWK'
# Small JSON reader retained for Homebrew's individual cask response.
function skip_space(s, p) { while (substr(s,p,1) ~ /[ \t\r\n]/) p++; return p }
function decode_string(s, p,    i,c,e,out) {
  out=""; i=p+1
  while (i<=length(s)) {
    c=substr(s,i,1)
    if (c=="\\") {
      e=substr(s,i+1,1); i+=2
      if      (e=="n" || e=="r" || e=="t") out=out " "
      else if (e=="b" || e=="f") out=out " "
      else if (e=="u") { out=out "\\u" substr(s,i,4); i+=4 }
      else out=out e
    } else if (c=="\"") return out
    else { out=out c; i++ }
  }
  return out
}
function value_end(s,p,    i,c,q,esc,depth) {
  p=skip_space(s,p); c=substr(s,p,1)
  if (c=="\"") {
    i=p+1; esc=0
    for (;i<=length(s);i++) { c=substr(s,i,1); if (esc) esc=0; else if(c=="\\") esc=1; else if(c=="\"") return i+1 }
    return length(s)+1
  }
  if (c=="{" || c=="[") {
    depth=1; q=0; esc=0
    for(i=p+1;i<=length(s);i++) {
      c=substr(s,i,1)
      if(q) { if(esc) esc=0; else if(c=="\\") esc=1; else if(c=="\"") q=0; continue }
      if(c=="\"") q=1
      else if(c=="{" || c=="[") depth++
      else if(c=="}" || c=="]") { depth--; if(depth==0) return i+1 }
    }
    return length(s)+1
  }
  i=p
  while(i<=length(s)) {
    c=substr(s,i,1)
    if(c=="," || c=="}" || c=="]" || c~/[ \t\r\n]/) break
    i++
  }
  return i
}
function object_member(obj,key,    p,k,v,e) {
  p=skip_space(obj,2)
  while(p<=length(obj) && substr(obj,p,1)!="}") {
    if(substr(obj,p,1)!= "\"") return ""
    k=decode_string(obj,p); p=value_end(obj,p); p=skip_space(obj,p)
    if(substr(obj,p,1)!=":") return ""
    p=skip_space(obj,p+1); e=value_end(obj,p); v=substr(obj,p,e-p)
    if(k==key) return v
    p=skip_space(obj,e); if(substr(obj,p,1)==",") p=skip_space(obj,p+1); else break
  }
  return ""
}
function scalar_member(obj,key,    v,p,e) {
  v=object_member(obj,key); if(v=="") return ""
  if(substr(v,1,1)=="\"") return decode_string(v,1)
  if(substr(v,1,1)=="[") {
    p=skip_space(v,2)
    if(substr(v,p,1)=="\"") return decode_string(v,p)
    return ""
  }
  if(v=="null") return ""
  return v
}
function first_array_object(array,    p,e) {
  p=skip_space(array,2)
  while(p<=length(array) && substr(array,p,1)!="{") p++
  if(p>length(array)) return ""
  e=value_end(array,p); return substr(array,p,e-p)
}
function count_field(obj,key,    copy,pattern) {
  # gsub performs the scan in the AWK implementation rather than repeatedly
  # allocating progressively shorter substrings (quadratic on large objects).
  copy=obj
  pattern="\"" key "\"[ \t\r\n]*:"
  return gsub(pattern,"",copy)
}
function print_search_record(obj,    name,id,url) {
  name=scalar_member(obj, source=="fontshare" ? "name" : "family")
  id=source=="fontshare" ? scalar_member(obj,"slug") : name
  if(name=="" || id=="") return
  url=source=="fontshare" ? "https://www.fontshare.com/fonts/" id : "https://fonts.google.com/specimen/" name
  gsub(/ /,"%20",url)
  printf "%s\t%s\t%s\n",name,id,url
}
function print_font_details(obj,    name,slug,story,cat,lic,views,recent,pub,designers,design,styles,var,added,updated,axes,fonts,desc,home,dl,ver,stats,period,periods,period_data,analytics,count,i) {
  if(source=="fontshare") {
    name=scalar_member(obj,"name"); slug=scalar_member(obj,"slug")
    story=scalar_member(obj,"story"); cat=scalar_member(obj,"category"); lic=scalar_member(obj,"license_type")
    views=scalar_member(obj,"views"); recent=scalar_member(obj,"views_recent")
    pub=scalar_member(object_member(obj,"publisher"),"name")
    designers=first_array_object(object_member(obj,"designers")); design=scalar_member(designers,"name")
    styles=count_field(object_member(obj,"styles"),"id")
    var=scalar_member(obj,"is_variable")=="true" ? "yes" : "no"
    added=scalar_member(obj,"inserted_at")
    printf "%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%d\034%s\034%s\034%s\n",name,story,cat,lic,views,recent,pub,design,styles,var,added,slug
  } else if(source=="google") {
    name=scalar_member(obj,"family"); cat=scalar_member(obj,"category"); design=scalar_member(obj,"designer")
    added=scalar_member(obj,"dateAdded"); updated=scalar_member(obj,"lastModified")
    fonts=object_member(obj,"fonts"); styles=count_field(fonts,"filename")
    axes=count_field(object_member(obj,"axes"),"tag"); desc=scalar_member(obj,"description")
    printf "%s\034%s\034%s\034%s\034%s\034%d\034%d\034%s\n",name,cat,design,added,updated,styles,axes,desc
  } else if(source=="homebrew") {
    name=scalar_member(obj,"name"); desc=scalar_member(obj,"desc")
    homepage=scalar_member(obj,"homepage"); download=scalar_member(obj,"url")
    version=scalar_member(obj,"version"); analytics=object_member(object_member(obj,"analytics"),"install")
    stats=""; periods[1]="30d"; periods[2]="90d"; periods[3]="365d"
    for(i=1;i<=3;i++) {
      period=periods[i]; period_data=object_member(analytics,period)
      if(match(period_data, /:[[:space:]]*[0-9]+/)) {
        count=substr(period_data,RSTART,RLENGTH); gsub(/[^0-9]/,"",count)
        stats=stats period " " count " installs; "
      }
    }
    sub(/; $/,"",stats)
    gsub(/[\t\r\n]+/," ",desc)
    printf "%s\034%s\034%s\034%s\034%s\034%s\n",name,desc,homepage,download,version,stats
  }
}
BEGIN { RS = "\034" }
{ json=$0 }
END {
  root=substr(json,skip_space(json,1))
  if(source=="homebrew") { print_font_details(root); exit }
  collection=source=="fontshare" ? "fonts" : "familyMetadataList"
  array=object_member(root,collection); if(array=="") exit 1
  p=2
  while(p<=length(array)) {
    p=skip_space(array,p); if(substr(array,p,1)=="]") break
    if(substr(array,p,1)!="{") { p=value_end(array,p); p=skip_space(array,p); if(substr(array,p,1)==",") p++; continue }
    e=value_end(array,p); obj=substr(array,p,e-p)
    candidate=source=="fontshare" ? scalar_member(obj,"slug") : scalar_member(obj,"family")
    name=source=="fontshare" ? scalar_member(obj,"name") : candidate
    if(mode=="search" || tolower(candidate)==tolower(wanted) || tolower(name)==tolower(wanted)) {
      if(mode=="search") print_search_record(obj); else { print_font_details(obj); found=1 }
      if(mode=="show") exit
    }
    p=skip_space(array,e); if(substr(array,p,1)==",") p++
  }
  if(mode=="show" && !found) exit 1
}
JSON_AWK
  awk -v source="${_source}" -v wanted="${_wanted}" -v mode="${_mode}" \
    -f "${_parser}" "${_input_file}"
}

describe "search" <<HEREDOC
Usage:
  ${_ME} search <string-or-regex>

Description:
  Search the Homebrew font casks, Fontshare, and Google Fonts catalogs for
  font names matching a string or extended regular expression. Matching is
  case-insensitive. Results include the source, install command, and catalog
  URL.

Requirements:
  curl, grep, awk, sed, wc, tr

Examples:
  ${_ME} search "space grotesk"
  ${_ME} search "^(space|clash)"
  ${_ME} search "mono$"
HEREDOC
search() {
  if (($# == 0))
  then
    _exit_1 printf "Usage: %s search <string-or-regex>\n" "${_ME}"
  fi

  local _query="$*"
  local _catalog_file=
  local _records_file=
  local _matches_file=
  local _source=
  local _url=
  local _offset=0
  local _total=0
  local _name=
  local _identifier=
  local _page_url=
  local _command=
  local _grep_status=0
  local __required_commands=(curl grep awk sed)
  local __command=

  for __command in "${__required_commands[@]}"
  do
    _command_exists "${__command}" ||
      _exit_1 printf "Required command not found: %s\n" "${__command}"
  done

  # Validate the expression before making network requests.
  printf "" | grep -E -i -e "${_query}" >/dev/null 2>&1 || _grep_status=$?
  if ((_grep_status == 2))
  then
    _exit_1 printf "Invalid search pattern: %s\n" "${_query}"
  fi

  _catalog_file="$(_temp file .json)"
  _records_file="$(_temp file .txt)"
  _matches_file="$(_temp file .txt)"

  # Normalize JSON catalogs to the common name/identifier/page format.
  _json_records() {
    _json_catalog "${1}" "" search "${2}"
  }

  # _show_matches()
  # Apply the expression and print the common result format for one source.
  _show_matches() {
    local _show_source="${1}"
    : > "${_matches_file}"
    grep -E -i -e "${_query}" "${_records_file}" > "${_matches_file}" || :
    printf "%s:\n" "${_show_source}"
    if [[ ! -s "${_matches_file}" ]]
    then
      printf "  (no matches)\n"
      return 0
    fi
    while IFS=$'\t' read -r _name _identifier _page_url
    do
      [[ -n "${_name}" ]] || continue
      case "${_show_source}" in
        Homebrew) _command="${_ME} install homebrew ${_identifier}" ;;
        Fontshare) _command="${_ME} install fontshare ${_identifier}" ;;
        Google) printf -v _command '%s install google %q' "${_ME}" "${_identifier}" ;;
      esac
      printf "  %s\n    %s\n    %s\n" "${_name}" "${_command}" "${_page_url}"
      _total=$((_total + 1))
    done < "${_matches_file}"
  }

  # Fetch independent catalogs concurrently so network latency is shared.
  local _homebrew_file=$(_temp file .html)
  local _fontshare_file=$(_temp file .json)
  local _google_file=$(_temp file .json)
  local _fontshare_records=$(_temp file .txt)
  local _page_file=
  local _page_records=
  local _count_total=0
  local _max_offset=0
  local _batch_offset=0
  local _page_offset=0
  local _pids=()
  local _page_files=()
  local _page_records_files=()
  local _page_index=0
  local _pid=

  printf "Searching catalogs...\n" 1>&2
  curl -fsSL --connect-timeout 3 --max-time 8 \
    "https://formulae.brew.sh/cask-font/" -o "${_homebrew_file}" &
  local _homebrew_pid=$!
  curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
    "https://fonts.google.com/metadata/fonts" -o "${_google_file}" &
  local _google_pid=$!
  # Fontshare currently exposes a small catalog (about 100 families). Request
  # it in one response rather than paging through it; the larger page size also
  # avoids a second round-trip if the catalog grows modestly.
  curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
    "https://api.fontshare.com/v2/fonts?limit=1000&offset=0" -o "${_fontshare_file}" &
  local _fontshare_pid=$!

  # Homebrew's font listing is a dedicated HTML page.
  if wait "${_homebrew_pid}"; then
    awk '
      function cell_text(value) {
        gsub(/<[^>]*>/, "", value)
        gsub(/&amp;/, "\&", value)
        gsub(/&quot;/, "\"", value)
        gsub(/&#39;/, sprintf("%c", 39), value)
        gsub(/&nbsp;/, " ", value)
        return value
      }
      {
        row = row $0
        if (index(row, "</tr>") == 0) next
        token = row
        sub(/^.*href="\/cask\//, "", token)
        sub(/".*$/, "", token)
        if (token ~ /^font-/) {
          name = row
          while (match(name, /<td[^>]*>/)) {
            name = substr(name, RSTART + RLENGTH)
            stop = index(name, "</td>")
            if (!stop) break
            last = cell_text(substr(name, 1, stop - 1))
            name = substr(name, stop + 5)
          }
          if (last == "") last = token
          print last "\t" token "\thttps://formulae.brew.sh/cask/" token
        }
        row = ""
        last = ""
      }
    ' "${_homebrew_file}" > "${_records_file}"
  else
    _warn printf "homebrew: unable to fetch font listing\n"
    : > "${_records_file}"
  fi
  _show_matches "Homebrew"

  # The Fontshare API currently returns its complete catalog in one response.
  # Keeping this to one request avoids serial page discovery and pagination
  # latency on every search.
  : > "${_fontshare_records}"
  if wait "${_fontshare_pid}"; then
    _json_records fontshare "${_fontshare_file}" > "${_fontshare_records}"
  else
    _warn printf "fontshare: unable to fetch catalog (request timed out or failed)\n"
  fi
  cp "${_fontshare_records}" "${_records_file}"
  _show_matches "Fontshare"

  # Google Fonts prefixes its JSON response with an anti-hijacking marker.
  if wait "${_google_pid}"; then
    _json_catalog google "" search "${_google_file}" > "${_records_file}"
  else
    _warn printf "google: unable to fetch catalog\n"
    : > "${_records_file}"
  fi
  _show_matches "Google"

  printf "\n%s match(es)\n" "${_total}"
}

