describe "uninstall" <<HEREDOC
Usage:
  ${_ME} uninstall <source> <font>
  ${_ME} uninstall <url>
  ${_ME} uninstall [--source <source>] [--font <font>] [--url <url>]

Options:
  --font <font>      The font to uninstall, by name.
  --source <source>  The source the font was installed from.
  --url <url>        The URL of the font to uninstall.

Description:
  Uninstall a <font> from <source>, or a font <url>, by removing the files
  recorded when it was installed. The options are equivalent to the
  arguments and can be mixed with them. --url can't be combined with a
  source or font. For homebrew, the cask is removed with
  \`brew uninstall --cask\`.

Exit status:
  0  Font successfully uninstalled.
  1  Invalid parameters or no install record found.

Examples:
  ${_ME} uninstall fontshare paquito
  ${_ME} uninstall homebrew font-fira-code
  ${_ME} uninstall https://fonts.google.com/specimen/Montserrat
  ${_ME} uninstall --source fontshare --font paquito
  ${_ME} uninstall --url https://fonts.google.com/specimen/Montserrat
HEREDOC
uninstall() {
  local _arguments=()
  local _font=
  local _resolved=
  local _source=
  local _url=


  while ((${#}))
  do
    case "${1:-}" in
      --font|--source|--url)
        if [[ -z "${2:-}" ]]
        then
          _exit_1 printf "%s requires a value.\\n" "${1}"
        fi

        case "${1}" in
          --font)   _font="${2}"    ;;
          --source) _source="${2}"  ;;
          --url)    _url="${2}"     ;;
        esac

        shift
        ;;
      *)
        if [[ -z "${_source:-}" ]]
        then
          _source="${1:-}"
        elif [[ -z "${_font:-}" ]]
        then
          _font="${1:-}"
        else
          _arguments+=("${1:-}")
        fi
        ;;
    esac

    shift
  done

  if [[ -n "${_url}" ]]
  then
    if ! _is_url "${_url}"
    then
      _exit_1 printf "Invalid URL: %s\\n" "${_url}"
    fi

    if [[ -n "${_source}" ]] || [[ -n "${_font}" ]]
    then
      _exit_1 printf "A URL can't be combined with a source or font.\\n"
    fi

    _source="${_url}"
  fi

  if [[ -z "${_font:-}" ]] && _is_url "${_source:-}"
  then
    _resolved="$(_resolve_font_url "${_source}")"

    _source="${_resolved%% *}"
    _font="${_resolved#* }"
  fi

  if [[ -z "${_source:-}" ]] ||
     [[ -z "${_font:-}"   ]]
  then
    _exit_1 printf "Usage: %s uninstall ( <source> <font> | <url> | --source <source> --font <font> | --url <url> )\\n" "${_ME}"
  fi

  local _manifest_file=
  _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"

  if [[ "${_source}" == "homebrew" ]]
  then
    _command_exists brew ||
      _exit_1 printf "Required command not found: brew\\n"

    if ! brew list --cask "${_font}" >/dev/null 2>&1
    then
      _exit_1 printf "Not installed: '%s' (%s)\\n" "${_font}" "${_source}"
    fi

    if ! brew uninstall --cask "${_font}"
    then
      _exit_1 printf "Failed to uninstall '%s' with homebrew.\\n" "${_font}"
    fi

    rm -f "${_manifest_file}"
    rmdir "$(dirname "${_manifest_file}")" 2>/dev/null || true

    printf "Removed '%s' (%s)\n" "${_font}" "${_source}"
    return 0
  fi

  if [[ ! -f "${_manifest_file}" ]]
  then
    _exit_1 printf "No manifest found for '%s' from '%s'.\\n" "${_font}" "${_source}"
  fi

  local _installed_path=
  local _removed=0

  while IFS= read -r _installed_path
  do
    if  [[ -n "${_installed_path}" ]] &&
        [[ -e "${_installed_path}" ]]
    then
      rm -f "${_installed_path}"
      _removed=$((_removed + 1))
    fi
  done < "${_manifest_file}"

  rm -f "${_manifest_file}"
  rmdir "$(dirname "${_manifest_file}")" 2>/dev/null || true

  _refresh_font_cache

  printf "Removed %d font file(s) for '%s' (%s)\n"  \
    "${_removed}"                                   \
    "${_font}"                                      \
    "${_source}"
}

