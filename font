describe "show" <<HEREDOC
Usage:
  ${_ME} show <font-or-url>
  ${_ME} show <source> <font>
  ${_ME} show [--source <source>] <font>

Options:
  --font <font>      The font to display information about, by name.
  --source <source>  The source the font is available from.
  --url <url>        A font page URL or direct font file URL.

Description:
  Display available information about a font, including its description,
  category, designer, license, styles, statistics, catalog page, download
  URL, and installation status. Available fields depend on the source.

Sources:
  fontshare   A font from Fontshare, by slug or family name.
  google      A font family from Google Fonts, by family name.
  homebrew    A font cask from Homebrew, by cask name. macOS only.
  url         A direct link to a font archive or file.

Examples:
  ${_ME} show satoshi
  ${_ME} show "Times New Roman Bold Italic.ttf"
  ${_ME} show fontshare satoshi
  ${_ME} show fontshare "General Sans"
  ${_ME} show google "Open Sans"
  ${_ME} show homebrew font-fira-code
  ${_ME} show https://www.fontshare.com/fonts/paquito
  ${_ME} show https://fonts.google.com/specimen/Montserrat
  ${_ME} show https://example.com/fonts/Example.zip
HEREDOC
_find_installed_font() {
  local wanted="${1##*/}"
  local dir path base
  local dirs=("${_FONT_DIR}" "${HOME}/Library/Fonts" /Library/Fonts
              /System/Library/Fonts /System/Library/Fonts/Supplemental
              "${HOME}/.fonts" /usr/local/share/fonts /usr/share/fonts)
  local wanted_lower="${wanted,,}"

  [[ -f "${1}" ]] && { printf '%s\n' "$1"; return 0; }

  for dir in "${dirs[@]}"
  do
    [[ -d "${dir}" ]] || continue
    while IFS= read -r path
    do
      base="${path##*/}"
      if [[ "${base,,}" == "${wanted_lower}" ]]
      then
        printf '%s\n' "${path}"
        return 0
      fi
    done < <(find "${dir}" -type f -print 2>/dev/null)
  done
  return 1
}

show() {
  local _font= _source= _url= _resolved= _positional_source=0
  local _source_was_given=0 _local_path= _metadata_line=
  local _page_url= _download_url= _description= _category= _designer=
  local _publisher= _license= _version= _date_added= _updated=
  local _views= _recent_views= _styles= _variable= _axes= _homepage=
  local _name= _manifest_file= _installed_path=
  local _total=0 _present=0 _missing=0
  local _fontshare_file= _google_file= _brew_file= _records_file=
  local _fontshare_pid= _google_pid= _brew_pid= _candidate=

  while (($#))
  do
    case "$1" in
      --font|--source|--url)
        [[ -n "${2:-}" ]] || _exit_1 printf '%s requires a value.\n' "$1"
        case "$1" in
          --font) _font="$2" ;;
          --source) _source="$2"; _source_was_given=1 ;;
          --url) _url="$2" ;;
        esac
        shift 2
        ;;
      *)
        if [[ -z "${_source}" && -z "${_font}" ]]; then
          _font="$1"
        elif [[ -z "${_source}" && -n "${_font}" ]]; then
          _source="${_font}"
          _font="$1"
          _source_was_given=1
        elif [[ -n "${_source}" && -z "${_font}" ]]; then
          _font="$1"
        else
          _exit_1 printf 'Unexpected argument: %s\n' "$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -n "${_url}" ]]; then
    [[ -z "${_source}" && -z "${_font}" ]] ||
      _exit_1 printf 'A URL cannot be combined with a source or font.\n'
    _source="${_url}"
  elif [[ -z "${_source}" ]] && _is_url "${_font}"; then
    _source="${_font}"
    _font=
  fi

  # A single positional URL or --url is resolved to a known source when
  # possible; otherwise it remains a direct URL.
  if [[ -z "${_font}" ]] && _is_url "${_source}"
  then
    _url="${_source}"
    if _resolved="$(_resolve_font_url "${_url}" 2>/dev/null)"; then
      _source="${_resolved%% *}"
      _font="${_resolved#* }"
    else
      _source=url
      _font="${_url##*/}"
    fi
  fi

  [[ -n "${_font}" ]] ||
    _exit_1 printf 'Usage: %s show [<source>] <font-or-url>\n' "${_ME}"

  # A source-less lookup first checks installed files. This makes local fonts
  # fast to identify and avoids network requests for the common local case.
  if [[ -z "${_source}" ]]; then
    if _local_path="$(_find_installed_font "${_font}")"; then
      _source=local
    else
      # A Homebrew cask token is unambiguous. Check it before font-family
      # catalogs so a token such as font-meslo-for-powerline cannot be
      # mistaken for a Fontshare slug or another similarly named family.
      if [[ "${_font}" == font-* ]]; then
        _brew_file="$(_temp file .json)"
        if curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
          "https://formulae.brew.sh/api/cask/${_font}.json" -o "${_brew_file}"; then
          if _metadata_line="$(_json_catalog homebrew "${_font}" show "${_brew_file}")"; then
            _source=homebrew
          fi
        fi
      fi

      # Resolve remaining names against Fontshare and Google Fonts in parallel.
      if [[ -z "${_source}" ]]; then
      _fontshare_file="$(_temp file .json)"
      _google_file="$(_temp file .json)"
      curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
        'https://api.fontshare.com/v2/fonts?limit=1000&offset=0' -o "${_fontshare_file}" &
      _fontshare_pid=$!
      curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
        'https://fonts.google.com/metadata/fonts' -o "${_google_file}" &
      _google_pid=$!

      if wait "${_fontshare_pid}"; then
        if _metadata_line="$(_json_catalog fontshare "${_font}" show "${_fontshare_file}")"; then
          _source=fontshare
        fi
      fi
      if [[ -z "${_source}" ]] && wait "${_google_pid}"; then
        if _metadata_line="$(_json_catalog google "${_font}" show "${_google_file}")"; then
          _source=google
        fi
      else
        wait "${_google_pid}" 2>/dev/null || :
      fi

      # Homebrew casks are named by token (for example font-fira-code).
      if [[ -z "${_source}" ]]; then
        _brew_file="$(_temp file .html)"
        _records_file="$(_temp file .txt)"
        if curl -fsSL --connect-timeout 3 --max-time 8 \
          'https://formulae.brew.sh/cask-font/' -o "${_brew_file}"; then
          awk '
            function clean(s) { gsub(/<[^>]*>/,"",s); gsub(/&amp;/,"\\&",s); return s }
            { row=row $0; if (index(row,"</tr>")==0) next
              token=row; sub(/^.*href="\/cask\//,"",token); sub(/".*$/, "", token)
              if (token ~ /^font-/) {
                name=row; last=""
                while (match(name, /<td[^>]*>/)) {
                  name=substr(name,RSTART+RLENGTH); stop=index(name,"</td>"); if (!stop) break
                  last=clean(substr(name,1,stop-1)); name=substr(name,stop+5)
                }
                if (last!="") print last "\t" token
              }
              row=""
            }
          ' "${_brew_file}" > "${_records_file}"
          _candidate="$(awk -F '\t' -v wanted="${_font}" 'tolower($1)==tolower(wanted) || tolower($2)==tolower(wanted) {print $2; exit}' "${_records_file}")"
          if [[ -n "${_candidate}" ]]; then
            _source=homebrew
            _font="${_candidate}"
          fi
        fi
      fi
      fi
    fi
  fi

  local _source_label="${_source}"
  case "${_source}" in
    local)
      _name="${_font##*/}"
      _page_url="${_local_path}"
      _download_url="${_local_path}"
      printf 'Name: %s\nSource: installed font\nFile: %s\nInstalled: yes\n' \
        "${_name}" "${_local_path}"
      return 0
      ;;
    fontshare|google|homebrew)
      _command_exists curl || _exit_1 printf 'Required command not found: curl\n'
      ;;
    url)
      _url="${_url:-${_font}}"
      _page_url="${_url}"
      _download_url="${_url}"
      ;;
    *)
      _exit_1 printf 'Font not found locally or in supported catalogs: %s\n' "${_font}"
      ;;
  esac

  case "${_source}" in
    fontshare)
      if [[ -z "${_metadata_line}" ]]; then
        _fontshare_file="$(_temp file .json)"
        curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
          'https://api.fontshare.com/v2/fonts?limit=1000&offset=0' -o "${_fontshare_file}" ||
          _exit_1 printf 'Unable to retrieve Fontshare catalog.\n'
        _metadata_line="$(_json_catalog fontshare "${_font}" show "${_fontshare_file}")" ||
          _exit_1 printf 'Fontshare font not found: %s\n' "${_font}"
      fi
      IFS=$'\034' read -r _name _description _category _license _views _recent_views _publisher _designer _styles _variable _date_added _candidate <<< "${_metadata_line}"
      _font="${_candidate}"
      case "${_license}" in itf_ffl) _license='ITF Free Font License' ;; sil_ofl) _license='SIL Open Font License' ;; esac
      _page_url="https://www.fontshare.com/fonts/${_font}"
      _download_url="https://api.fontshare.com/v2/fonts/download/${_font}"
      ;;
    google)
      if [[ -z "${_metadata_line}" ]]; then
        _google_file="$(_temp file .json)"
        curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
          'https://fonts.google.com/metadata/fonts' -o "${_google_file}" ||
          _exit_1 printf 'Unable to retrieve Google Fonts catalog.\n'
        _metadata_line="$(_json_catalog google "${_font}" show "${_google_file}")" ||
          _exit_1 printf 'Google Fonts family not found: %s\n' "${_font}"
      fi
      IFS=$'\034' read -r _name _category _designer _date_added _updated _styles _axes _description <<< "${_metadata_line}"
      [[ "${_axes:-0}" -gt 0 ]] && _variable="${_axes} axis/axes"
      _page_url="https://fonts.google.com/specimen/${_name// /%20}"
      _download_url="https://fonts.google.com/download?family=${_name// /%20}"
      ;;
    homebrew)
      if [[ -z "${_metadata_line}" ]]; then
        _brew_file="$(_temp file .json)"
        curl -fsSL --compressed --connect-timeout 3 --max-time 8 \
          "https://formulae.brew.sh/api/cask/${_font}.json" -o "${_brew_file}" ||
          _exit_1 printf 'Homebrew cask not found: %s\n' "${_font}"
        _metadata_line="$(_json_catalog homebrew "${_font}" show "${_brew_file}")" ||
          _exit_1 printf 'Unable to read Homebrew cask metadata: %s\n' "${_font}"
      fi
      IFS=$'\034' read -r _name _description _homepage _download_url _version _views <<< "${_metadata_line}"
      _page_url="https://formulae.brew.sh/cask/${_font}"
      ;;
  esac

  printf 'Name: %s\nSource: %s\n' "${_name:-${_font}}" "${_source_label}"
  [[ -n "${_description}" ]] && printf 'Description: %s\n' "${_description}"
  [[ -n "${_category}" ]] && printf 'Category: %s\n' "${_category}"
  [[ -n "${_designer}" ]] && printf 'Designer: %s\n' "${_designer}"
  [[ -n "${_publisher}" ]] && printf 'Publisher: %s\n' "${_publisher}"
  [[ -n "${_license}" ]] && printf 'License: %s\n' "${_license}"
  [[ -n "${_version}" ]] && printf 'Version: %s\n' "${_version}"
  [[ -n "${_date_added}" ]] && printf 'Added: %s\n' "${_date_added}"
  [[ -n "${_updated}" ]] && printf 'Last updated: %s\n' "${_updated}"
  [[ -n "${_styles}" ]] && printf 'Styles: %s\n' "${_styles}"
  [[ -n "${_variable}" ]] && printf 'Variable font: %s\n' "${_variable}"
  [[ -n "${_views}" ]] && printf 'Views: %s\n' "${_views}"
  [[ -n "${_recent_views}" ]] && printf 'Recent views: %s\n' "${_recent_views}"
  [[ -n "${_homepage}" ]] && printf 'Homepage: %s\n' "${_homepage}"
  printf 'Font page: %s\nDownload: %s\n' "${_page_url}" "${_download_url}"

  if [[ "${_source}" == homebrew ]]; then
    if _command_exists brew && brew list --cask "${_font}" >/dev/null 2>&1; then
      printf 'Installed: yes (Homebrew)\n'
    else
      printf 'Installed: no\n'
    fi
  else
    _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"
    if [[ -f "${_manifest_file}" ]]; then
      while IFS= read -r _installed_path; do
        [[ -n "${_installed_path}" ]] || continue
        _total=$((_total + 1))
        if [[ -e "${_installed_path}" ]]; then _present=$((_present + 1)); else _missing=$((_missing + 1)); fi
      done < "${_manifest_file}"
      if ((_total > 0 && _missing == 0)); then
        printf 'Installed: yes (%d/%d files present)\n' "${_present}" "${_total}"
      elif ((_present > 0)); then
        printf 'Installed: incomplete (%d/%d files present)\n' "${_present}" "${_total}"
      else
        printf 'Installed: no\n'
      fi
    else
      printf 'Installed: no\n'
    fi
  fi
}

# ------------------------------------------------------------------------ list

describe "list" <<HEREDOC
Usage:
  ${_ME} list [--source [<source>] | --no-source] [<search string>]

Options:
  --source [<source>]  Only list fonts with a recorded source. When <source>
                       is given, only fonts installed from <source>.
  --no-source          Only list fonts without a recorded source.

Description:
  List the fonts installed with ${_ME}, followed by all font files found in
  the system's font directories. When provided with a search string or
  regular expression, only matching entries are listed. Matching is
  case-insensitive.

  When --source is used, only fonts with a recorded source are listed, or
  only fonts installed from <source> when one is given, and the system font
  files are omitted. The argument after --source is read as its <source>, so
  a search string must come before a --source without one.

  When --no-source is used, only font files without a recorded source are
  listed. These are the font files found in the system's font directories
  that were not installed with ${_ME} or as Homebrew font casks.

Sources:
  fontshare, google, homebrew, url

Examples:
  ${_ME} list
  ${_ME} list satoshi
  ${_ME} list --source
  ${_ME} list --source google
  ${_ME} list --source homebrew mono
  ${_ME} list --no-source
  ${_ME} list mono --no-source
HEREDOC
list() {
  # _list_matches()
  #
  # Usage:
  #   _list_matches <string>
  #
  # Description:
  #   Succeed if <string> matches the search pattern, which is all strings
  #   when no search string was given.
  _list_matches() {
    printf "%s\\n" "${1:-}" | grep -q -E -i -e "${_query:-.}"
  }

  local _query=
  local _source_filter=
  local _found=0
  local _manifest_file=
  local _no_source=0
  local _system_dirs=()
  local _system_output=
  local _with_source=0

  while ((${#}))
  do
    case "${1:-}" in
      --source)
        _with_source=1

        # The next argument is the <source>, unless it's missing or an option.
        if [[ -n "${2:-}" ]] && [[ "${2}" != -* ]]
        then
          _source_filter="${2}"

          shift
        fi
        ;;
      --no-source)
        _no_source=1
        ;;
      *)
        if [[ -z "${_query}" ]]
        then
          _query="${1:-}"
        fi
        ;;
    esac

    shift
  done

  case "${_source_filter}" in
    ""|fontshare|google|homebrew|url)
      :
      ;;
    *)
      _exit_1 printf "Unsupported font source: %s\\n" "${_source_filter}"
      ;;
  esac

  if ((_with_source)) && ((_no_source))
  then
    _exit_1 printf "Can't combine --source and --no-source.\\n"
  fi

  # `grep` exits with `2` when the pattern is invalid and `1` for no match.
  local _grep_status=0
  printf "" | grep -E -i -e "${_query:-.}" >/dev/null 2>&1 || _grep_status=$?

  if ((_grep_status == 2))
  then
    _exit_1 printf "Invalid search pattern: %s\\n" "${_query}"
  fi

  local _candidate_dirs=("${_FONT_DIR}")

  case "${_OS}" in
    Darwin)
      _candidate_dirs+=(
        "${HOME}/Library/Fonts"
        "/Library/Fonts"
        "/System/Library/Fonts"
      )
      ;;
    *)
      _candidate_dirs+=(
        "${XDG_DATA_HOME:-${HOME}/.local/share}/fonts"
        "${HOME}/.fonts"
        "/usr/local/share/fonts"
        "/usr/share/fonts"
      )
      ;;
  esac

  local __dir=
  for   __dir in "${_candidate_dirs[@]}"
  do
    [[ -d "${__dir}" ]] && _system_dirs+=("${__dir}")
  done

  if ((_no_source))
  then
    local _found_paths=
    local _names=
    local _path=
    local _recorded=
    local _target=

    _recorded="$(cat "${_MANIFEST_DIR}"/*/* 2>/dev/null || :)"

    if ((${#_system_dirs[@]}))
    then
      _found_paths="$(
        find "${_system_dirs[@]}" \( -type f -o -type l \) \(  \
          -iname "*.otf" -o -iname "*.ttf"                    \
          -o -iname "*.ttc" -o -iname "*.otc"                 \
          -o -iname "*.dfont"                                 \
        \) -print 2>/dev/null || :
      )"
    fi

    # Skip the font files recorded in install manifests.
    if [[ -n "${_found_paths}" ]] && [[ -n "${_recorded}" ]]
    then
      _found_paths="$(
        printf "%s\\n" "${_found_paths}" |
          { grep -v -x -F -f <(printf "%s\\n" "${_recorded}") || :; }
      )"
    fi

    while IFS= read -r _path
    do
      [[ -n "${_path}" ]] || continue

      # Homebrew casks link their fonts into the font directory.
      if [[ -L "${_path}" ]]
      then
        _target="$(readlink "${_path}" 2>/dev/null || :)"

        if [[ "${_target}" == */Caskroom/* ]]
        then
          continue
        fi
      fi

      _names+="${_path##*/}"$'\n'
    done <<< "${_found_paths}"

    _system_output="$(
      printf "%s" "${_names}"                     \
        | sort -u                                 \
        | { grep -E -i -e "${_query:-.}" || :; }  \
        | sed -e 's/^/  /'
    )"

    printf "Without a recorded source:\\n"

    if [[ -n "${_system_output}" ]]
    then
      printf "%s\\n" "${_system_output}"
    elif [[ -n "${_query}" ]]
    then
      printf "  (no matches)\\n"
    else
      printf "  (none)\\n"
    fi

    return 0
  fi

  printf "Installed with %s:\\n" "${_ME}"

  local _entry=
  local _entries=()

  for _manifest_file in "${_MANIFEST_DIR}"/*/*
  do
    [[ -f "${_manifest_file}" ]] || continue

    _entry="$(basename "$(dirname "${_manifest_file}")") $(basename "${_manifest_file}")"

    # Homebrew font casks are listed from Homebrew itself, below.
    if [[ "${_entry}" == homebrew\ * ]]
    then
      continue
    fi

    _entries+=("${_entry}")
  done

  if [[ "${_OS}" == "Darwin" ]] &&
     [[ -z "${_source_filter}" || "${_source_filter}" == "homebrew" ]] &&
     _command_exists brew
  then
    local _cask=
    while IFS= read -r _cask
    do
      if [[ -n "${_cask}" ]]
      then
        _entries+=("homebrew ${_cask}")
      fi
    done < <(brew list --cask 2>/dev/null | { grep '^font-' || :; })
  fi

  for _entry in "${_entries[@]:-}"
  do
    [[ -n "${_entry}" ]] || continue

    if [[ -n "${_source_filter}" ]] &&
       [[ "${_entry}" != "${_source_filter} "* ]]
    then
      continue
    fi

    if _list_matches "${_entry}"
    then
      printf "  %s\\n" "${_entry}"

      _found=1
    fi
  done

  if ! ((_found))
  then
    if [[ -n "${_query}" ]]
    then
      printf "  (no matches)\\n"
    else
      printf "  (none)\\n"
    fi
  fi

  # System font files aren't associated with a source.
  if ((_with_source))
  then
    return 0
  fi

  printf "\\nInstalled on the system:\\n"

  if ((${#_system_dirs[@]}))
  then
    _system_output="$(
      { find "${_system_dirs[@]}" \( -type f -o -type l \) \( \
          -iname "*.otf" -o -iname "*.ttf"                    \
          -o -iname "*.ttc" -o -iname "*.otc"                 \
          -o -iname "*.dfont"                                 \
        \) -print 2>/dev/null || :; }                         \
        | sed -e 's|.*/||'                                    \
        | sort -u                                             \
        | { grep -E -i -e "${_query:-.}" || :; }              \
        | sed -e 's/^/  /'
    )"
  fi

  if [[ -n "${_system_output}" ]]
  then
    printf "%s\\n" "${_system_output}"
  elif [[ -n "${_query}" ]]
  then
    printf "  (no matches)\\n"
  else
    printf "  (none)\\n"
  fi
}

# ---------------------------------------------------------------------- status

describe "status" <<HEREDOC
Usage:
  ${_ME} status <source> <font>
  ${_ME} status <url>
  ${_ME} status [--source <source>] [--font <font>] [--url <url>]

Options:
  --font <font>      The font to check, by name.
  --source <source>  The source the font was installed from.
  --url <url>        The URL of the font to check.

Description:
  Check whether a <font> from <source>, or a font <url>, is installed. The
  options are equivalent to the arguments and can be mixed with them. --url
  can't be combined with a source or font. For homebrew, Homebrew is asked
  whether the cask is installed.

Exit status:
  0  Font is installed and all files are present.
  1  Font is not installed, or some files are missing.

Examples:
  ${_ME} status fontshare paquito
  ${_ME} status homebrew font-fira-code
  ${_ME} status https://fonts.google.com/specimen/Montserrat
  ${_ME} status --source fontshare --font paquito
  ${_ME} status --url https://fonts.google.com/specimen/Montserrat
HEREDOC
status() {
  local _arguments=()
  local _font=
  local _resolved=
  local _source=
  local _url=

  while ((${#}))
  do
    case "${1:-}" in
      --font|--source|--url)
        if [[ -z "${2:-}" ]]
        then
          _exit_1 printf "%s requires a value.\\n" "${1}"
        fi

        case "${1}" in
          --font)   _font="${2}"    ;;
          --source) _source="${2}"  ;;
          --url)    _url="${2}"     ;;
        esac

        shift
        ;;
      *)
        if [[ -z "${_source:-}" ]]
        then
          _source="${1:-}"
        elif [[ -z "${_font:-}" ]]
        then
          _font="${1:-}"
        else
          _arguments+=("${1:-}")
        fi
        ;;
    esac

    shift
  done

  if [[ -n "${_url}" ]]
  then
    if ! _is_url "${_url}"
    then
      _exit_1 printf "Invalid URL: %s\\n" "${_url}"
    fi

    if [[ -n "${_source}" ]] || [[ -n "${_font}" ]]
    then
      _exit_1 printf "A URL can't be combined with a source or font.\\n"
    fi

    _source="${_url}"
  fi

  if [[ -z "${_font:-}" ]] && _is_url "${_source:-}"
  then
    _resolved="$(_resolve_font_url "${_source}")"

    _source="${_resolved%% *}"
    _font="${_resolved#* }"
  fi

  if [[ -z "${_source:-}" ]] ||
     [[ -z "${_font:-}"   ]]
  then
    _exit_1 printf "Usage: %s status ( <source> <font> | <url> | --source <source> --font <font> | --url <url> )\\n" "${_ME}"
  fi

  if [[ "${_source}" == "homebrew" ]]
  then
    if _command_exists brew && brew list --cask "${_font}" >/dev/null 2>&1
    then
      printf "Installed: '%s' (%s)\\n" "${_font}" "${_source}"
      return 0
    fi

    printf "Not installed: '%s' (%s)\\n" "${_font}" "${_source}" >&2
    return 1
  fi

  local _manifest_file=
  _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"

  if [[ ! -f "${_manifest_file}" ]]
  then
    _debug printf "No manifest found at %s\\n" "${_manifest_file}"
    printf "Not installed: '%s' (%s)\\n" "${_font}" "${_source}" >&2
    return 1
  fi

  local _installed_path=
  local _total=0
  local _present=0
  local _missing=0

  while IFS= read -r _installed_path
  do
    if [[ -n "${_installed_path}"    ]]
    then
      _total=$((_total + 1))
      if [[ -e "${_installed_path}"  ]]
      then
        _present=$((_present + 1))

        _debug printf "Present: %s\\n" "${_installed_path}"
      else
        _missing=$((_missing + 1))

        _debug printf "Missing: %s\\n" "${_installed_path}"
      fi
    fi
  done < "${_manifest_file}"

  if (( _total > 0 )) && (( _missing == 0 ))
  then
    printf "Installed: '%s' (%s) [%d/%d file(s) present]\\n"  \
      "${_font}"                                              \
      "${_source}"                                            \
      "${_present}"                                           \
      "${_total}"
    return 0
  fi

  printf "Incomplete or missing: '%s' (%s) [%d/%d file(s) present]\\n"  \
    "${_font}"                                                          \
    "${_source}"                                                        \
    "${_present}"                                                       \
    "${_total}"                                                         >&2
  return 1
}

