describe "install" <<HEREDOC
Usage:
  ${_ME} install <source> <font>
  ${_ME} install <url>

Description:
  Install a <font> from <source>, or from a font <url>.

Sources:
  fontshare   A font from Fontshare, by name.
  google      A font family from Google Fonts, by name.
  homebrew    A font cask from Homebrew, by cask name. macOS only.
  url         A direct link to a .zip, .ttf, or .otf file.

URLs:
  Fontshare and Google Fonts pages, Homebrew cask pages, and direct links
  to .zip, .ttf, or .otf files are recognized, so a <url> can be used
  anywhere a <source> and <font> are accepted.

Examples:
  ${_ME} install fontshare paquito
  ${_ME} install google "Open Sans"
  ${_ME} install homebrew font-fira-code
  ${_ME} install https://www.fontshare.com/fonts/paquito
  ${_ME} install https://fonts.google.com/specimen/Montserrat
  ${_ME} install https://example.com/fonts/Example.zip
HEREDOC
install() {
  # _install_from_fontshare()
  #
  # Usage:
  #   _install_from_fontshare <font> <manifest_file>
  #
  # Description:
  #   Download a font archive from Fontshare's API, copy font files into
  #   `$_FONT_DIR`, and record installed paths in `<manifest_file>`.
  _install_from_fontshare() {
    _debug printf "_install_from_fontshare()\\n"

    local _font="${1}"
    local _manifest_file="${2}"
    local _url="https://api.fontshare.com/v2/fonts/download/${_font}"
    local _tmp_zip=
    local _tmp_dir=

    _tmp_zip="$(_temp file ".zip")"
    _tmp_dir="$(_temp file "extracted-${_font}")"

    mkdir -p "${_FONT_DIR}" "$(dirname "${_manifest_file}")" "${_tmp_dir}"

    _debug printf "Downloading %s from %s\\n" "${_font}" "${_url}"
    printf "Downloading '%s' from fontshare...\n" "${_font}"

    if ! curl -fsSL "${_url}" -o "${_tmp_zip}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to download '%s' from fontshare.\\n" "${_font}"
    fi

    if ! unzip -q "${_tmp_zip}" -d "${_tmp_dir}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to extract archive for '%s'.\\n" "${_font}"
    fi

    : > "${_manifest_file}"

    local _count=0
    local _base_name=
    local _dest_path=
    local _font_file=

    while IFS= read -r -d '' _font_file
    do
      _base_name="$(basename "${_font_file}")"
      _dest_path="${_FONT_DIR}/${_base_name}"

      cp -f "${_font_file}" "${_dest_path}"

      printf "%s\n" "${_dest_path}" >> "${_manifest_file}"

      _count=$((_count + 1))
    done < <(find "${_tmp_dir}" -type f \( -name "*.otf" -o -name "*.ttf" \) -print0)

    if (( _count == 0 ))
    then
      rm -f "${_manifest_file}"

      _exit_1 printf "No .otf or .ttf files found in archive for '%s'.\\n" "${_font}"
    fi

    printf "Installed %d font file(s) for '%s' into %s\n"   \
      "${_count}"                                           \
      "${_font}"                                            \
      "${_FONT_DIR}"
  }

  # _install_from_google()
  #
  # Usage:
  #   _install_from_google <font> <manifest_file>
  #
  # Description:
  #   Download a font family archive from Google Fonts, copy font files into
  #   `$_FONT_DIR`, and record installed paths in `<manifest_file>`.
  _install_from_google() {
    _debug printf "_install_from_google()\\n"

    local _font="${1}"
    local _manifest_file="${2}"
    local _url="https://fonts.google.com/download?family=${_font// /%20}"
    local _tmp_zip=
    local _tmp_dir=

    _tmp_zip="$(_temp file ".zip")"
    _tmp_dir="$(_temp file "extracted-${_font}")"

    mkdir -p "${_FONT_DIR}" "$(dirname "${_manifest_file}")" "${_tmp_dir}"

    _debug printf "Downloading %s from %s\\n" "${_font}" "${_url}"
    printf "Downloading '%s' from google...\n" "${_font}"

    if ! curl -fsSL "${_url}" -o "${_tmp_zip}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to download '%s' from google.\\n" "${_font}"
    fi

    if ! unzip -q "${_tmp_zip}" -d "${_tmp_dir}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to extract archive for '%s'.\\n" "${_font}"
    fi

    : > "${_manifest_file}"

    local _count=0
    local _base_name=
    local _dest_path=
    local _font_file=

    while IFS= read -r -d '' _font_file
    do
      _base_name="$(basename "${_font_file}")"
      _dest_path="${_FONT_DIR}/${_base_name}"

      cp -f "${_font_file}" "${_dest_path}"

      printf "%s\n" "${_dest_path}" >> "${_manifest_file}"

      _count=$((_count + 1))
    done < <(find "${_tmp_dir}" -type f \( -name "*.otf" -o -name "*.ttf" \) -print0)

    if (( _count == 0 ))
    then
      rm -f "${_manifest_file}"

      _exit_1 printf "No .otf or .ttf files found in archive for '%s'.\\n" "${_font}"
    fi

    printf "Installed %d font file(s) for '%s' into %s\n"   \
      "${_count}"                                           \
      "${_font}"                                            \
      "${_FONT_DIR}"
  }

  # _install_from_homebrew()
  #
  # Usage:
  #   _install_from_homebrew <font> <manifest_file>
  #
  # Description:
  #   Install a font cask with Homebrew and record the cask name in
  #   `<manifest_file>`. Homebrew manages the font files, so the manifest only
  #   marks the cask as installed with this program.
  _install_from_homebrew() {
    _debug printf "_install_from_homebrew()\\n"

    local _font="${1}"
    local _manifest_file="${2}"

    if [[ "${_OS}" != "Darwin" ]]
    then
      _exit_1 printf "Homebrew font casks are only available on macOS.\\n"
    fi

    if [[ "${_font}" != font-* ]]
    then
      _exit_1 printf "Not a font cask: '%s'. Font casks start with 'font-'.\\n" "${_font}"
    fi

    mkdir -p "$(dirname "${_manifest_file}")"

    printf "Installing '%s' with homebrew...\n" "${_font}"

    if ! brew install --cask "${_font}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to install '%s' with homebrew.\\n" "${_font}"
    fi

    printf "%s\n" "${_font}" > "${_manifest_file}"

    printf "Installed '%s' with homebrew\n" "${_font}"
  }

  # _install_from_url()
  #
  # Usage:
  #   _install_from_url <font> <manifest_file> <url>
  #
  # Description:
  #   Download a .zip archive or a single .ttf or .otf file from <url>, copy
  #   font files into `$_FONT_DIR`, and record installed paths in
  #   `<manifest_file>`.
  _install_from_url() {
    _debug printf "_install_from_url()\\n"

    local _font="${1}"
    local _manifest_file="${2}"
    local _url="${3:-}"

    if [[ -z "${_url}" ]]
    then
      _exit_1 printf "A URL is required. Usage: %s install <url>\\n" "${_ME}"
    fi

    local _url_path="${_url%%[?#]*}"
    local _file_name=
    local _extension=
    local _tmp_download=
    local _tmp_dir=

    _file_name="$(_url_decode "${_url_path##*/}")"
    _extension="$(printf "%s" "${_file_name##*.}" | tr '[:upper:]' '[:lower:]')"

    case "${_extension}" in
      zip|ttf|otf)
        :
        ;;
      *)
        _exit_1 printf "Unsupported URL: %s\\nExpected a fontshare, google, or homebrew page, or a link to a .zip, .ttf, or .otf file.\\n" "${_url}"
        ;;
    esac

    _tmp_download="$(_temp file ".${_extension}")"
    _tmp_dir="$(_temp file "extracted-${_font}")"

    mkdir -p "${_FONT_DIR}" "$(dirname "${_manifest_file}")" "${_tmp_dir}"

    _debug printf "Downloading %s from %s\\n" "${_font}" "${_url}"
    printf "Downloading '%s' from %s...\n" "${_font}" "${_url}"

    if ! curl -fsSL "${_url}" -o "${_tmp_download}"
    then
      rm -f "${_manifest_file}"
      _exit_1 printf "Failed to download '%s'.\\n" "${_url}"
    fi

    if [[ "${_extension}" == "zip" ]]
    then
      if ! unzip -q "${_tmp_download}" -d "${_tmp_dir}"
      then
        rm -f "${_manifest_file}"
        _exit_1 printf "Failed to extract archive for '%s'.\\n" "${_font}"
      fi
    else
      cp -f "${_tmp_download}" "${_tmp_dir}/${_file_name}"
    fi

    : > "${_manifest_file}"

    local _count=0
    local _base_name=
    local _dest_path=
    local _font_file=

    while IFS= read -r -d '' _font_file
    do
      _base_name="$(basename "${_font_file}")"
      _dest_path="${_FONT_DIR}/${_base_name}"

      cp -f "${_font_file}" "${_dest_path}"

      printf "%s\n" "${_dest_path}" >> "${_manifest_file}"

      _count=$((_count + 1))
    done < <(find "${_tmp_dir}" -type f \( -name "*.otf" -o -name "*.ttf" \) -print0)

    if (( _count == 0 ))
    then
      rm -f "${_manifest_file}"

      _exit_1 printf "No .otf or .ttf files found for '%s'.\\n" "${_font}"
    fi

    printf "Installed %d font file(s) for '%s' into %s\n"   \
      "${_count}"                                           \
      "${_font}"                                            \
      "${_FONT_DIR}"
  }

  _debug printf "_install()\\n"

  local _arguments=()
  local _font=
  local _font_url=
  local _resolved=
  local _source=


  while ((${#}))
  do
    case "${1:-}" in
      *)
        if [[ -z "${_source:-}" ]]
        then
          _source="${1:-}"
        elif [[ -z "${_font:-}" ]]
        then
          _font="${1:-}"
        else
          _arguments+=("${1:-}")
        fi
    esac

    shift
  done

  if [[ -z "${_font:-}" ]] && _is_url "${_source:-}"
  then
    _font_url="${_source}"
    _resolved="$(_resolve_font_url "${_font_url}")"

    _source="${_resolved%% *}"
    _font="${_resolved#* }"
  fi

  if [[ -z "${_source:-}" ]] ||
     [[ -z "${_font:-}"   ]]
  then
    _exit_1 printf "Usage: %s install ( <source> <font> | <url> )\\n" "${_ME}"
  fi

  local _required_commands=(curl unzip)

  if [[ "${_source}" == "homebrew" ]]
  then
    _required_commands=(brew)
  fi

  local __command=
  for   __command in "${_required_commands[@]}"
  do
    _command_exists "${__command}" ||
      _exit_1 printf "Required command not found: %s\\n" "${__command}"
  done

  local _manifest_file=
  _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"

  case "${_source}" in
    fontshare)
      _install_from_fontshare "${_font}" "${_manifest_file}"
      ;;
    google)
      _install_from_google "${_font}" "${_manifest_file}"
      ;;
    homebrew)
      _install_from_homebrew "${_font}" "${_manifest_file}"
      ;;
    url)
      _install_from_url "${_font}" "${_manifest_file}" "${_font_url}"
      ;;
    *)
      _exit_1 printf "Unsupported font source: %s\\n" "${_source}"
      ;;
  esac

  _refresh_font_cache
}

# ------------------------------------------------------------------------ list

describe "list" <<HEREDOC
Usage:
  ${_ME} list [--source <source>] [<search string>]

Options:
  --source <source>  Only list fonts installed from <source>.

Description:
  List the fonts installed with ${_ME}, followed by all font files found in
  the system's font directories. When provided with a search string or
  regular expression, only matching entries are listed. Matching is
  case-insensitive.

  When --source is used, only fonts installed from the specified source are
  listed, and the system font files are omitted.

Sources:
  fontshare, google, homebrew, url

Examples:
  ${_ME} list
  ${_ME} list satoshi
  ${_ME} list --source google
  ${_ME} list --source homebrew mono
HEREDOC
list() {
  # _list_matches()
  #
  # Usage:
  #   _list_matches <string>
  #
  # Description:
  #   Succeed if <string> matches the search pattern, which is all strings
  #   when no search string was given.
  _list_matches() {
    printf "%s\\n" "${1:-}" | grep -q -E -i -e "${_query:-.}"
  }

  local _query=
  local _source_filter=
  local _found=0
  local _manifest_file=
  local _system_dirs=()
  local _system_output=

  while ((${#}))
  do
    case "${1:-}" in
      --source)
        _source_filter="${2:-}"

        if [[ -z "${_source_filter}" ]]
        then
          _exit_1 printf "Usage: %s list [--source <source>] [<search string>]\\n" "${_ME}"
        fi

        shift
        ;;
      *)
        if [[ -z "${_query}" ]]
        then
          _query="${1:-}"
        fi
        ;;
    esac

    shift
  done

  case "${_source_filter}" in
    ""|fontshare|google|homebrew|url)
      :
      ;;
    *)
      _exit_1 printf "Unsupported font source: %s\\n" "${_source_filter}"
      ;;
  esac

  # `grep` exits with `2` when the pattern is invalid and `1` for no match.
  local _grep_status=0
  printf "" | grep -E -i -e "${_query:-.}" >/dev/null 2>&1 || _grep_status=$?

  if ((_grep_status == 2))
  then
    _exit_1 printf "Invalid search pattern: %s\\n" "${_query}"
  fi

  printf "Installed with %s:\\n" "${_ME}"

  local _entry=
  local _entries=()

  for _manifest_file in "${_MANIFEST_DIR}"/*/*
  do
    [[ -f "${_manifest_file}" ]] || continue

    _entry="$(basename "$(dirname "${_manifest_file}")") $(basename "${_manifest_file}")"

    # Homebrew font casks are listed from Homebrew itself, below.
    if [[ "${_entry}" == homebrew\ * ]]
    then
      continue
    fi

    _entries+=("${_entry}")
  done

  if [[ "${_OS}" == "Darwin" ]] &&
     [[ -z "${_source_filter}" || "${_source_filter}" == "homebrew" ]] &&
     _command_exists brew
  then
    local _cask=
    while IFS= read -r _cask
    do
      if [[ -n "${_cask}" ]]
      then
        _entries+=("homebrew ${_cask}")
      fi
    done < <(brew list --cask 2>/dev/null | { grep '^font-' || :; })
  fi

  for _entry in "${_entries[@]:-}"
  do
    [[ -n "${_entry}" ]] || continue

    if [[ -n "${_source_filter}" ]] &&
       [[ "${_entry}" != "${_source_filter} "* ]]
    then
      continue
    fi

    if _list_matches "${_entry}"
    then
      printf "  %s\\n" "${_entry}"

      _found=1
    fi
  done

  if ! ((_found))
  then
    if [[ -n "${_query}" ]]
    then
      printf "  (no matches)\\n"
    else
      printf "  (none)\\n"
    fi
  fi

  # System font files aren't associated with a source.
  if [[ -n "${_source_filter}" ]]
  then
    return 0
  fi

  local _candidate_dirs=("${_FONT_DIR}")

  case "${_OS}" in
    Darwin)
      _candidate_dirs+=(
        "${HOME}/Library/Fonts"
        "/Library/Fonts"
        "/System/Library/Fonts"
      )
      ;;
    *)
      _candidate_dirs+=(
        "${XDG_DATA_HOME:-${HOME}/.local/share}/fonts"
        "${HOME}/.fonts"
        "/usr/local/share/fonts"
        "/usr/share/fonts"
      )
      ;;
  esac

  local __dir=
  for   __dir in "${_candidate_dirs[@]}"
  do
    [[ -d "${__dir}" ]] && _system_dirs+=("${__dir}")
  done

  printf "\\nInstalled on the system:\\n"

  if ((${#_system_dirs[@]}))
  then
    _system_output="$(
      { find "${_system_dirs[@]}" \( -type f -o -type l \) \( \
          -iname "*.otf" -o -iname "*.ttf"                    \
          -o -iname "*.ttc" -o -iname "*.otc"                 \
          -o -iname "*.dfont"                                 \
        \) -print 2>/dev/null || :; }                         \
        | sed -e 's|.*/||'                                    \
        | sort -u                                             \
        | { grep -E -i -e "${_query:-.}" || :; }              \
        | sed -e 's/^/  /'
    )"
  fi

  if [[ -n "${_system_output}" ]]
  then
    printf "%s\\n" "${_system_output}"
  elif [[ -n "${_query}" ]]
  then
    printf "  (no matches)\\n"
  else
    printf "  (none)\\n"
  fi
}

# ---------------------------------------------------------------------- status

describe "status" <<HEREDOC
Usage:
  ${_ME} status <source> <font>
  ${_ME} status <url>

Description:
  Check whether a <font> from <source>, or a font <url>, is installed. For
  homebrew, Homebrew is asked whether the cask is installed.

Exit status:
  0  Font is installed and all files are present.
  1  Font is not installed, or some files are missing.

Examples:
  ${_ME} status fontshare paquito
  ${_ME} status homebrew font-fira-code
  ${_ME} status https://fonts.google.com/specimen/Montserrat
HEREDOC
status() {
  local _arguments=()
  local _font=
  local _resolved=
  local _source=

  while ((${#}))
  do
    case "${1:-}" in
      *)
        if [[ -z "${_source:-}" ]]
        then
          _source="${1:-}"
        elif [[ -z "${_font:-}" ]]
        then
          _font="${1:-}"
        else
          _arguments+=("${1:-}")
        fi
        ;;
    esac

    shift
  done

  if [[ -z "${_font:-}" ]] && _is_url "${_source:-}"
  then
    _resolved="$(_resolve_font_url "${_source}")"

    _source="${_resolved%% *}"
    _font="${_resolved#* }"
  fi

  if [[ -z "${_source:-}" ]] ||
     [[ -z "${_font:-}"   ]]
  then
    _exit_1 printf "Usage: %s status ( <source> <font> | <url> )\\n" "${_ME}"
  fi

  if [[ "${_source}" == "homebrew" ]]
  then
    if _command_exists brew && brew list --cask "${_font}" >/dev/null 2>&1
    then
      printf "Installed: '%s' (%s)\\n" "${_font}" "${_source}"
      return 0
    fi

    printf "Not installed: '%s' (%s)\\n" "${_font}" "${_source}" >&2
    return 1
  fi

  local _manifest_file=
  _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"

  if [[ ! -f "${_manifest_file}" ]]
  then
    _debug printf "No manifest found at %s\\n" "${_manifest_file}"
    printf "Not installed: '%s' (%s)\\n" "${_font}" "${_source}" >&2
    return 1
  fi

  local _installed_path=
  local _total=0
  local _present=0
  local _missing=0

  while IFS= read -r _installed_path
  do
    if [[ -n "${_installed_path}"    ]]
    then
      _total=$((_total + 1))
      if [[ -e "${_installed_path}"  ]]
      then
        _present=$((_present + 1))

        _debug printf "Present: %s\\n" "${_installed_path}"
      else
        _missing=$((_missing + 1))

        _debug printf "Missing: %s\\n" "${_installed_path}"
      fi
    fi
  done < "${_manifest_file}"

  if (( _total > 0 )) && (( _missing == 0 ))
  then
    printf "Installed: '%s' (%s) [%d/%d file(s) present]\\n"  \
      "${_font}"                                              \
      "${_source}"                                            \
      "${_present}"                                           \
      "${_total}"
    return 0
  fi

  printf "Incomplete or missing: '%s' (%s) [%d/%d file(s) present]\\n"  \
    "${_font}"                                                          \
    "${_source}"                                                        \
    "${_present}"                                                       \
    "${_total}"                                                         >&2
  return 1
}

# ------------------------------------------------------------------- uninstall

describe "uninstall" <<HEREDOC
Usage:
  ${_ME} uninstall <source> <font>
  ${_ME} uninstall <url>

Description:
  Uninstall a <font> from <source>, or a font <url>, by removing the files
  recorded when it was installed. For homebrew, the cask is removed with
  \`brew uninstall --cask\`.

Exit status:
  0  Font successfully uninstalled.
  1  Invalid parameters or no install record found.

Examples:
  ${_ME} uninstall fontshare paquito
  ${_ME} uninstall homebrew font-fira-code
  ${_ME} uninstall https://fonts.google.com/specimen/Montserrat
HEREDOC
uninstall() {
  local _arguments=()
  local _font=
  local _resolved=
  local _source=


  while ((${#}))
  do
    case "${1:-}" in
      *)
        if [[ -z "${_source:-}" ]]
        then
          _source="${1:-}"
        elif [[ -z "${_font:-}" ]]
        then
          _font="${1:-}"
        else
          _arguments+=("${1:-}")
        fi
    esac

    shift
  done

  if [[ -z "${_font:-}" ]] && _is_url "${_source:-}"
  then
    _resolved="$(_resolve_font_url "${_source}")"

    _source="${_resolved%% *}"
    _font="${_resolved#* }"
  fi

  if [[ -z "${_source:-}" ]] ||
     [[ -z "${_font:-}"   ]]
  then
    _exit_1 printf "Usage: %s uninstall ( <source> <font> | <url> )\\n" "${_ME}"
  fi

  local _manifest_file=
  _manifest_file="$(_font_manifest_path "${_source}" "${_font}")"

  if [[ "${_source}" == "homebrew" ]]
  then
    _command_exists brew ||
      _exit_1 printf "Required command not found: brew\\n"

    if ! brew list --cask "${_font}" >/dev/null 2>&1
    then
      _exit_1 printf "Not installed: '%s' (%s)\\n" "${_font}" "${_source}"
    fi

    if ! brew uninstall --cask "${_font}"
    then
      _exit_1 printf "Failed to uninstall '%s' with homebrew.\\n" "${_font}"
    fi

    rm -f "${_manifest_file}"
    rmdir "$(dirname "${_manifest_file}")" 2>/dev/null || true

    printf "Removed '%s' (%s)\n" "${_font}" "${_source}"
    return 0
  fi

  if [[ ! -f "${_manifest_file}" ]]
  then
    _exit_1 printf "No manifest found for '%s' from '%s'.\\n" "${_font}" "${_source}"
  fi

  local _installed_path=
  local _removed=0

  while IFS= read -r _installed_path
  do
    if  [[ -n "${_installed_path}" ]] &&
        [[ -e "${_installed_path}" ]]
    then
      rm -f "${_installed_path}"
      _removed=$((_removed + 1))
    fi
  done < "${_manifest_file}"

  rm -f "${_manifest_file}"
  rmdir "$(dirname "${_manifest_file}")" 2>/dev/null || true

  _refresh_font_cache

  printf "Removed %d font file(s) for '%s' (%s)\n"  \
    "${_removed}"                                   \
    "${_font}"                                      \
    "${_source}"
}

